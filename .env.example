# Nukopijuok į ignoruojamą .env.local tik prijungdamas savo projektą.
# Vieši Supabase duomenys, NE secret ar service_role raktas.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
# Tikras šios programos adresas. Po publikavimo naudoti HTTPS adresą.
SITE_URL=http://localhost:3000
# Tik serveriui. Tikros reikšmės lieka ignoruojamame .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=
# Atsitiktinis >=32 simbolių HMAC raktas. Pakeitus ankstesnių tyrimų parašai nebegalios.
AI_SERVER_SECRET=
# Įjungti tik pritaikius AI migraciją ir patvirtinus modelį / bandymo ribą.
AI_STORAGE_ENABLED=false
AI_LIVE_ENABLED=false
